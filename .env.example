# Copy this file to ".env" (git-ignored) and fill in YOUR OWN PayPal SANDBOX app credentials.
# Never commit ".env". Never use live credentials: the app only talks to api-m.sandbox.paypal.com.
# Create the app at https://developer.paypal.com (Apps & Credentials -> Sandbox). See docs/JUDGE-RUN.md.

# Sandbox app Client ID (placeholder - replace with your own)
PAYPAL_CLIENT_ID=your-sandbox-client-id-here

# Sandbox app Secret (placeholder - replace with your own)
PAYPAL_CLIENT_SECRET=your-sandbox-secret-here

# --- Optional settings (all read on every call; no restart needed) ---

# Local Ollama model. Default qwen3.5:9b (qwen3:14b also works). Without Ollama the app runs in manual mode.
# COPILOT_MODEL=qwen3.5:9b

# Local Ollama server URL. Default http://127.0.0.1:11434.
# COPILOT_OLLAMA_URL=http://127.0.0.1:11434

# Seller Protection rule set to check against (ISO-2 country; supported: MX, US - see copilot/rules/README.md). Default MX.
# COPILOT_RULES_COUNTRY=MX

# Dispute ids that the automatic background preparation should skip (comma-separated). Empty by default: nothing is skipped.
# COPILOT_AUTOPREP_EXCLUDE=
# Feature flags for this release: 75 settings, 72 enabled; hosted demo documents, webhooks and webhook verification default off. The appeal call is on; it is sent once per approved request and only while PayPal offers an appeal. Code defaults stay off without configuration.

COPILOT_FEATURE_ACCOUNT_CLIFF=true
# Account cliff path: the dated path to the high-volume dispute rule on the account page; reads only.
COPILOT_FEATURE_ACCOUNT_CLIFF_PATH=true
COPILOT_FEATURE_ACTIVE_APPROVAL=true
# Seller shortcuts: prefill what the seller would otherwise retype (proposed approval note, one-step upload and prepare, offer and message, values read from the document). Every approval and every send still needs the seller's own click.
COPILOT_FEATURE_SELLER_SHORTCUTS=true
# Appeal workspace: local, read-only organiser for an appeal on a closed case; sends nothing.
COPILOT_FEATURE_APPEAL_WORKSPACE=true
COPILOT_FEATURE_BILINGUAL=true
COPILOT_FEATURE_CARRIER_REQUIRED=true
COPILOT_FEATURE_CLAIMS=true
COPILOT_FEATURE_CLAUSES=true
COPILOT_FEATURE_CONFORMANCE=true
COPILOT_FEATURE_DEADLINES=true
COPILOT_FEATURE_DELIVERY_FACTS=true
COPILOT_FEATURE_DEMO_DOCUMENTS=false
# Seeded demo case (local): one confirmed click proposes the demo documents and shipment fields, labelled DEMO DATA; the seller reviews and approves.
COPILOT_FEATURE_DEMO_DOCUMENTS_SEEDED=true
# Inbox watch: a box on the inbox that checks PayPal every 15 seconds for a newly opened case; it can be unticked at any time.
COPILOT_FEATURE_INBOX_WATCH=true
COPILOT_FEATURE_DRAFT=true
# Evaluation workbench: provenance manifest and fixed historical reference; no scorer is run.
COPILOT_FEATURE_EVALUATION_WORKBENCH=true
COPILOT_FEATURE_EVENTS=true
# Evidence dossier: reason-to-proof matrix, claim sources and annex inventory on the package page.
COPILOT_FEATURE_EVIDENCE_DOSSIER=true
# Explainable queue: says why each dispute sits where it does in the inbox; same order, no re-sorting.
COPILOT_FEATURE_EXPLAINABLE_QUEUE=true
COPILOT_FEATURE_FULFILMENT=true
COPILOT_FEATURE_FULFILMENT_REGISTER=true
# Local walkthrough page: a guided tour of the features over a chosen case.
COPILOT_FEATURE_JUDGE_WALKTHROUGH=true
COPILOT_FEATURE_LEDGER=true
# Policy simulator: every result is SIMULATED, NOT SENT; only a local JSONL is written.
COPILOT_FEATURE_LOCAL_AUTOPILOT=true
# Local demo hub: one page that lists what this checkout can show for a case.
COPILOT_FEATURE_LOCAL_DEMO_HUB=true
# Local MCP contracts (stdio server only): list/read local cases, prepare a local note; no PayPal calls.
COPILOT_FEATURE_MCP_LOCAL_CONTRACTS=true
# Negotiation drafts: local history of drafts; hands off to the read-only resolution preview.
COPILOT_FEATURE_NEGOTIATION_DRAFTS=true
COPILOT_FEATURE_OUTCOME=true
COPILOT_FEATURE_OUTCOME_APPEAL=true
COPILOT_FEATURE_PACKAGE_PRINT=true
COPILOT_FEATURE_REPLAY=true
COPILOT_FEATURE_RESOLUTION=true
COPILOT_FEATURE_RESOLUTION_WRITES=true
# Status message: the registered tracking written as a message to review and send once, or as a note headed Not sent by Proofie.
COPILOT_FEATURE_RESOLUTION_STATUS_MESSAGE=true
# Sale readiness: internal checklist for a sale transaction; not a PayPal requirement.
COPILOT_FEATURE_SALE_READINESS=true
COPILOT_FEATURE_TIMELINE=true
COPILOT_FEATURE_TRIAGE=true
COPILOT_FEATURE_WEBHOOKS=false
COPILOT_FEATURE_WEBHOOKS_VERIFY=false
COPILOT_FEATURE_JUDGE_AS_BUYER=true
COPILOT_FEATURE_BUYER_NOTE=true
COPILOT_FEATURE_SHIP_MOMENT_CAPTURE=true
COPILOT_FEATURE_CARRIER_DIRECTORY=true
COPILOT_FEATURE_SALE_LESSON=true
COPILOT_FEATURE_CALL_SCRIPT=true
COPILOT_FEATURE_READ_ALOUD_REVIEW=true
COPILOT_FEATURE_SECOND_OPINION=true
COPILOT_FEATURE_ACCOUNTING_LINE=true
COPILOT_FEATURE_OFFLINE_MARKET_MODE=true
COPILOT_FEATURE_DECLARED_LIMITS=true
COPILOT_FEATURE_PRESENTATION_MODE=true
COPILOT_FEATURE_TWO_CLOCKS=true
COPILOT_FEATURE_DO_NOTHING_PATH=true
COPILOT_FEATURE_PACKAGE_INSERT=true
COPILOT_FEATURE_SHIP_NOTICE=true
COPILOT_FEATURE_STATUS_LINK=true
# Signing key for buyer status links (32+ characters, operator secret; leave empty to keep link creation off)
COPILOT_STATUS_LINK_KEY=
# Optional public address of the hosted copy, so a local app builds links the buyer can open (https only)
COPILOT_STATUS_LINK_BASE=
COPILOT_FEATURE_FIRST_DISPUTE_GUIDE=true
COPILOT_FEATURE_THIRD_PARTY_STATEMENT=true
COPILOT_FEATURE_TRADE_PROFILES=true

COPILOT_FEATURE_LESSONS_EXCHANGE=true
COPILOT_FEATURE_SEASON_PREP=true
COPILOT_FEATURE_LOST_PACKAGE_PATHS=true
COPILOT_FEATURE_CASE_HISTORY=true
COPILOT_FEATURE_CASE_REENTRY=true
COPILOT_FEATURE_ATTENTION_MODEL=true
COPILOT_FEATURE_CLOSURE_SUMMARY=true
COPILOT_FEATURE_GAP_RESOLUTION=true
COPILOT_FEATURE_INCIDENT_PROPOSALS=true
COPILOT_FEATURE_LOCAL_PREPARATION=true
COPILOT_FEATURE_SELECTED_PREPARATION=true
COPILOT_FEATURE_TRANSIT_DELIVERED_GUIDE=true
# Re-armed case: the escalate note our own helper (tools/sandbox_dispute_state.py --rearm) leaves on a dispute does not count as
# evidence already sent. Any other seller evidence still closes the send.
COPILOT_FEATURE_REARM_NOTE_IGNORED=true
# Hosted judge mode (R2-A): a pool of open sandbox disputes a judge can start with one click. Hosted demo only; the pool is the
# operator's allowlist COPILOT_JUDGE_POOL (comma-separated dispute ids), which stays unset in this file.
COPILOT_FEATURE_JUDGE_POOL=true
# Operator note (hosted copy): each acceptance retires a pool case; refill via the operator list or the card route.
# Caps (copilot/features/accept_claim/service.py): an acceptance is refused when it would leave fewer than 2 unused pool cases (POOL_FLOOR),
# a judge session gets 1 (ACCEPTS_PER_SESSION), and the copy takes 1 per America/Mexico_City day (ACCEPTS_PER_DAY). Local installs have none of these.
# Accept the claim: the seller's last option, a page of its own offered while PayPal shows the action. It refunds the buyer and closes the dispute; the seller types the amount phrase and approves the exact request, and the send is a separate click. Proofie never proposes it. On the hosted demo it is allowed on the judge's own pool case and refused on every other case.
COPILOT_FEATURE_ACCEPT_CLAIM=true
